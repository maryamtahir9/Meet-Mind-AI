# Neon PostgreSQL Connection String
# Example: postgresql://neondb_owner:npg_xyz@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Groq API Key (for Llama-3.3-70b-versatile, Whisper-large-v3, and fast reasoning)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=""

# Gemini API Key (Alternative fallback model)
GEMINI_API_KEY=""

# Host and Port Configuration
PORT=3000
NODE_ENV="development"
